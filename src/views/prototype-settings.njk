{% extends "template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageTitle = "Prototype settings - HMCTS API Marketplace - GOV.UK" %}
{% set breadcrumbs = [{ text: "Home", href: "/" }] %}

{# Not in the real service. Lists the switchable Phase 2 features from src/data/features.json;
   prototype-settings.js builds the checkboxes and the shareable link. #}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Prototype settings</h1>

    <p class="govuk-body">
      This prototype starts from the API Marketplace as it is today. Phase 2 ideas are added as features you
      can switch on and off, so you can see one without another.
    </p>

    {{ govukInsetText({
      text: "Your choice is kept in this browser only. It does not change what anyone else sees."
    }) }}

    <p class="govuk-body" id="features-none" hidden>There are no Phase 2 features to switch on yet.</p>

    <form method="get" action="/prototype-settings/" novalidate id="features-form" hidden>
      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset" aria-describedby="features-hint">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
            <h2 class="govuk-fieldset__heading">Features</h2>
          </legend>
          <div id="features-hint" class="govuk-hint">Select the features to show.</div>
          <div class="govuk-checkboxes" data-module="govuk-checkboxes" id="features-list"></div>
        </fieldset>
      </div>

      <div class="govuk-button-group">
        {{ govukButton({ text: "Save settings", attributes: { id: "features-save" } }) }}
        <a class="govuk-link" href="/prototype-settings/?features=default" id="features-reset">Go back to the defaults</a>
      </div>
    </form>

    <div id="features-share" hidden>
      <h2 class="govuk-heading-m">Share these settings</h2>
      <p class="govuk-body">
        Anyone who opens this link sees the prototype with the same features switched on. It works on any page:
        add the same <code>?features=</code> ending to its address.
      </p>
      <p class="govuk-body"><a class="govuk-link" id="features-link" href="./"></a></p>
    </div>

    <h2 class="govuk-heading-m">Example data</h2>
    <p class="govuk-body">
      Signs you in as the example user and adds an application, Case progress tracker, with three made-up
      APIs. Two of them are in a production credentials request already: one approved, one still submitted.
      The third has not been requested, so you can ask for it.
    </p>
    <p class="govuk-body">
      The outcomes for each API show when Production requests for each API is switched on. With Get production
      credentials yourself switched on too, Court Schedule's production credentials are ready to get from the
      application page.
    </p>
    <p class="govuk-body">
      To record a decision yourself, sign in as an admin and open the request from the Admin tab.
    </p>
    {{ govukButton({
      text: "Add the example application",
      classes: "govuk-button--secondary",
      attributes: { id: "example-data" }
    }) }}

    <h3 class="govuk-heading-s">Start again</h3>
    <p class="govuk-body">
      Removes every application and production credentials request in this browser, including the example, and
      any answers you have half filled in. You stay signed in and your feature choices are kept.
    </p>
    {{ govukButton({
      text: "Clear example data",
      classes: "govuk-button--warning",
      attributes: { id: "clear-data" }
    }) }}
  </div>
</div>
{% endblock %}
