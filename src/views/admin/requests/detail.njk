{% extends "template.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set pageTitle = "Production request - Admin - HMCTS API Marketplace - GOV.UK" %}
{% set section = "admin" %}
{% set breadcrumbs = [{ text: "Home", href: "/" }, { text: "Admin", href: "/admin" }, { text: "Production requests", href: "/admin/requests" }] %}

{% block content %}
<div data-feature-page="admin-dashboard">
{% include "admin/denied.njk" %}

<div id="admin-content" hidden>
  {# Laid out like the requester's own request page (production-credentials/view.njk), so the two
     read the same: the APIs and the answers in the same order, under the same headings. The
     admin page adds who asked, and the decision. #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Production credentials request</span>
      <h1 class="govuk-heading-xl" id="admin-heading"></h1>

      <p class="govuk-body">
        Status: <strong class="govuk-tag govuk-tag--blue apim-tag--nowrap" id="admin-request-status"></strong>
        <br>Submitted <span id="admin-request-submitted"></span>
        <br>Requested by <span id="admin-request-owner"></span>
      </p>

      <div data-feature="production-request-per-api" hidden>
        <h2 class="govuk-heading-m">APIs in this request</h2>
        <dl class="govuk-summary-list" id="admin-request-apis"></dl>
      </div>

      <h2 class="govuk-heading-m">Their answers</h2>
      {{ govukSummaryList({ rows: [], attributes: { id: "admin-request-answers" } }) }}
    </div>
  </div>

  {# Phase 2, getting production credentials yourself: the Data Access Team record their decision
     here, which emails the requester. Other admins see the history only. admin.js builds both. #}
  <div data-feature="production-credentials-self-serve" hidden>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds" id="admin-request-decision"></div>
    </div>
    <div id="admin-request-history"></div>
  </div>
</div>
</div>
{% endblock %}
