{% extends "template.njk" %}

{% from "govuk/components/details/macro.njk" import govukDetails %}

{% set pageTitle = "API - Manage applications - HMCTS API Marketplace - GOV.UK" %}
{% set section = "applications" %}
{% set breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "Manage applications", href: "/account/applications" },
  { text: "Application", href: "/account/applications" }
] %}

{# The real service renders this page from the backend, with the subscription key from API
   Management. Here applications.js fills it from the browser's own store, using the application's
   id and the API in the query string. #}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <span class="govuk-caption-l" data-application-name></span>
    <h1 class="govuk-heading-xl" id="api-title"></h1>

    <dl class="govuk-summary-list" id="api-details"></dl>

    {% set keyHtml %}
      <p class="govuk-body apim-credential govuk-!-font-weight-bold" id="subscription-key"></p>
      <p class="govuk-body">Send it in the <code>Ocp-Apim-Subscription-Key</code> header with every call to this API. Keep it secret.</p>
    {% endset %}
    {{ govukDetails({ summaryText: "Show subscription key", html: keyHtml, attributes: { id: "show-subscription-key" } }) }}

    <p class="govuk-body"><a class="govuk-link" href="/account/applications" id="back-to-application">Back to <span data-application-name></span></a></p>
  </div>
</div>
{% endblock %}
