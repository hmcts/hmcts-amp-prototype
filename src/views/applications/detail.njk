{% extends "template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "Application - Manage applications - HMCTS API Marketplace - GOV.UK" %}
{% set section = "applications" %}
{% set breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "Your account", href: "/account" },
  { text: "Manage applications", href: "/account/applications" }
] %}

{# The real service renders this page from the backend. Here applications.js fills it
   from the browser's own store, using the id in the query string. #}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <span class="govuk-caption-l">Application</span>
    <h1 class="govuk-heading-xl" data-application-name></h1>

    <h2 class="govuk-heading-m">Basic details</h2>
    <dl class="govuk-summary-list" id="application-details"></dl>

    {# Phase 2, 'application-page-tabs' and 'application-page-cards': application-layout.js makes
       these two sections into tabs or summary cards. Without either, they show as in the real service. #}
    <div id="try-it-now" data-section-title="Try it now">
    <h2 class="govuk-heading-m">Authorisation details</h2>
    <p class="govuk-body">Use your client ID and secret to get an access token from Microsoft Entra ID for your calls.</p>
    <dl class="govuk-summary-list" id="authorisation-details"></dl>

    {% include "applications/access.njk" %}

    <h2 class="govuk-heading-m">APIs added</h2>
    {# As the real service: a table with a View subscription key link for each API, and the API's
       instructions (applications/instructions.njk) folded away in a full-width row under it.
       applications.js fills in the rows. #}
    <table class="govuk-table" id="application-apis" hidden>
      <caption class="govuk-table__caption govuk-visually-hidden">APIs added to this application</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">API</th>
          <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
        </tr>
      </thead>
      <tbody class="govuk-table__body" id="application-apis-rows"></tbody>
    </table>
    <p class="govuk-body" id="apis-empty" hidden>No APIs added yet.</p>

    <div class="govuk-button-group">
      {{ govukButton({
        text: "Add or remove APIs",
        href: "../apis/",
        classes: "govuk-button--secondary",
        attributes: { id: "change-apis" }
      }) }}
    </div>
    </div>

    <div id="production" data-section-title="Production">
    <h2 class="govuk-heading-m" id="going-live-heading">Going live</h2>
    {# The real service renders one of these, depending on whether the application has a production
       request. Both ship here and applications.js shows the right one. #}
    <p class="govuk-body" id="production-request" hidden>
      You have asked for production credentials for this application.
      <a class="govuk-link" href="../../production-credentials/view/" id="view-production-request">View production request <span id="production-request-reference"></span></a>.
    </p>
    <p class="govuk-body" id="request-production">
      When this application has been tested,
      <a class="govuk-link" href="../../production-credentials/" id="going-live">request production credentials</a> for it.
    </p>
    {# Phase 2, production requests for each API: instead of the two paragraphs above, where each API
       stands, and a link to ask for any API not yet in a request. applications.js fills it in. #}
    <div data-feature="production-request-per-api" hidden>
      <div data-feature-off="production-apis-table">
        <dl class="govuk-summary-list" id="production-apis-status"></dl>
        <p class="govuk-body" id="request-more-apis" hidden>
          <a class="govuk-link" href="../../production-credentials/" id="request-more-apis-link">Request production access for <span id="request-more-apis-text">more APIs</span></a>
        </p>
      </div>
      {# Phase 2, 'production-apis-table': each API's status and what to do next, in one table, with
         its production subscription key folded under it once made. applications.js fills it in. #}
      <table class="govuk-table" id="production-apis-table" data-feature="production-apis-table" hidden>
        <caption class="govuk-table__caption govuk-visually-hidden">Production access for each API</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">API</th>
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
          </tr>
        </thead>
        <tbody class="govuk-table__body" id="production-apis-table-rows"></tbody>
      </table>
    </div>

    {# Phase 2, getting production credentials yourself: approved APIs waiting to be collected, and
       the production credentials once made. production-access.js fills it in. #}
    <div data-feature="production-credentials-self-serve" hidden>
      <div id="production-ready"></div>
      <div id="production-section" hidden>
        <h2 class="govuk-heading-m">Production credentials</h2>
        <dl class="govuk-summary-list" id="production-credentials"></dl>
        <div data-feature-off="production-apis-table">
          <h3 class="govuk-heading-s">Production subscription keys</h3>
          <dl class="govuk-summary-list" id="production-keys"></dl>
        </div>
      </div>
    </div>
    </div>

    <h2 class="govuk-heading-m">Delete this application</h2>
    <p class="govuk-body">Its client ID, secret and subscription keys stop working straight away.</p>
    {{ govukButton({
      text: "Delete application",
      href: "../delete/",
      classes: "govuk-button--warning",
      attributes: { id: "delete-application" }
    }) }}

    <p class="govuk-body"><a class="govuk-link" href="../">Back to your applications</a></p>
  </div>
</div>
{% endblock %}
