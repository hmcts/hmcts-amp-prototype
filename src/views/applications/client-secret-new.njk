{% extends "template.njk" %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "New client secret - HMCTS API Marketplace - GOV.UK" %}
{% set section = "applications" %}
{% set hideBackLink = true %}

{# Phase 2, 'regenerate-client-secret'. As the real service's page was: the new secret, shown
   once. applications.js shows it only straight after it is made; reloading does not show it again. #}
{% block content %}
<div data-feature-page="regenerate-client-secret">
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    {{ govukPanel({ titleText: "Client secret regenerated" }) }}

    <div id="new-secret" hidden>
      {% include "applications/secret-once.njk" %}
      <p class="govuk-body">It expires on <span id="new-secret-expires"></span>.</p>
    </div>
    <p class="govuk-body" id="new-secret-gone" hidden>
      The client secret is no longer shown. If you did not keep it, regenerate it again from the application page.
    </p>

    {{ govukButton({ text: "Back to application", href: "/account/applications", attributes: { id: "back-to-application" } }) }}
  </div>
</div>
</div>
{% endblock %}
