{% extends "template.njk" %}

{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "Regenerate client secret - HMCTS API Marketplace - GOV.UK" %}
{% set section = "applications" %}
{% set breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "Manage applications", href: "/account/applications" },
  { text: "Application", href: "/account/applications" }
] %}

{# Phase 2, 'regenerate-client-secret'. The real service had this page, with this wording, until
   AMP-1103 (October 2026) took it out because the backend has no way to replace a secret.
   applications.js fills in the application and makes the new secret in the browser's own store. #}
{% block content %}
<div data-feature-page="regenerate-client-secret">
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <span class="govuk-caption-l" data-application-name></span>
    <h1 class="govuk-heading-xl">Regenerate client secret</h1>

    <p class="govuk-body">The current secret is <span class="apim-credential" id="current-secret"></span>.</p>

    {{ govukWarningText({
      text: "The current secret will stop working straight away. Update your software with the new secret as soon as you have it.",
      iconFallbackText: "Warning"
    }) }}

    <p class="govuk-body">You will see the new secret only once, so have somewhere secure to keep it first.</p>

    <form id="regenerate-form" novalidate>
      <div class="govuk-button-group">
        {{ govukButton({ text: "Regenerate client secret", classes: "govuk-button--warning", attributes: { id: "confirm-regenerate" } }) }}
        <a class="govuk-link" href="/account/applications" id="cancel-regenerate">Cancel</a>
      </div>
    </form>
  </div>
</div>
</div>
{% endblock %}
