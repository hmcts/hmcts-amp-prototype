{% extends "template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set pageTitle = "Regenerate the production client secret - HMCTS API Marketplace - GOV.UK" %}
{% set section = "applications" %}
{% set breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "Your account", href: "/account" },
  { text: "Manage applications", href: "/account/applications" }
] %}

{# Phase 2, getting production credentials yourself. production-access.js does the work. #}
{% block content %}
<div data-feature-page="production-credentials-self-serve">
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <span class="govuk-caption-l" data-application-name></span>
    <h1 class="govuk-heading-xl">Regenerate the production client secret</h1>

    {{ govukWarningText({
      text: "Your current production client secret stops working straight away. Services that use it cannot call our APIs until you give them the new one.",
      iconFallbackText: "Warning"
    }) }}

    <p class="govuk-body">You will see the new secret only once, so have somewhere secure to keep it first.</p>

    <div class="govuk-button-group">
      {{ govukButton({ text: "Regenerate client secret", classes: "govuk-button--warning", attributes: { id: "regenerate-secret" } }) }}
      <a class="govuk-link" href="/account/applications" data-application-link>Cancel</a>
    </div>
  </div>
</div>
</div>
{% endblock %}
