{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
<h2 class="govuk-heading-m">Access to the APIs</h2>
{# The real service renders one of these two, from whether the backend has granted the application's
   roles in Entra yet. Both ship here: applications.js shows the right one and fakes the retries that
   application-access.ts makes. #}
<p class="govuk-body" id="access-granted" hidden>{{ govukTag({ text: "Set up", classes: "govuk-tag--green" }) }}</p>
<div id="application-access" hidden>
  <div id="access-pending">
    {{ govukWarningText({
      text: "These credentials will not work yet. Access to the APIs is still being set up, which can take a couple of minutes.",
      iconFallbackText: "Warning"
    }) }}
  </div>
  <p class="govuk-body" id="access-status" role="status" aria-live="polite"></p>
  <form id="check-access-form" novalidate>
    {{ govukButton({ text: "Check access", classes: "govuk-button--secondary", attributes: { id: "check-access" } }) }}
  </form>
</div>
